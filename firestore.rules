rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A customer can create only their own private profile.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'businessName', 'bio',
          'avatarPath', 'avatarType', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'businessName', 'bio',
          'avatarPath', 'avatarType', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() <= 120
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && request.resource.data.avatarPath == ''
        && request.resource.data.avatarType == ''
        && request.resource.data.createdAt == request.time;

      // Profile documents are visible only to their owner.
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // A customer may edit only their own profile fields.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'businessName', 'bio',
          'avatarPath', 'avatarType', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() <= 120
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && request.resource.data.avatarPath is string
        && (
          request.resource.data.avatarPath == ''
          || request.resource.data.avatarPath == 'users/' + userId + '/profile/avatar'
        )
        && request.resource.data.avatarType is string
        && (
          request.resource.data.avatarType == ''
          || request.resource.data.avatarType.matches('image/(jpeg|png|webp)')
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Deny access to every other collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
