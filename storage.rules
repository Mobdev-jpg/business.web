rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Private profile photo: only the owning customer can access their avatar.
    match /users/{userId}/profile/avatar {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // Allow the owner to delete the existing avatar, or upload an image under 10 MiB.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          request.resource == null
          || (
            request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)')
          )
        );
    }

    // Deny all other file access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
